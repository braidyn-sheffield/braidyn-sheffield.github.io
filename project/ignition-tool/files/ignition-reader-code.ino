void setup() {

  Serial.begin(9600); 

  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
    for(;;); // Don't proceed, loop forever
  }
  display.display(); // Show initial display buffer contents on the screen
  delay(1000); // Pause for 0.5 seconds

  display.clearDisplay(); // Clear the buffer
  display.drawBitmap(0, 0, bmfs_bitmap, 128, 32, WHITE);
  display.display();
  delay(3000);


  display.clearDisplay(); // Clear the buffer

}



void loop() {

  int sensorValue1 = analogRead(SENSOR1);
  int sensorValue2 = analogRead(SENSOR2);
  int sensorValue3 = analogRead(SENSOR3);
  int sensorValue4 = analogRead(SENSOR4);
  int sensorValue5 = analogRead(SENSOR5);

  float voltage1 = (sensorValue1 * (5.0 / 1023.0)) * ((R1 + R2) / R2);
  float voltage2 = (sensorValue2 * (5.0 / 1023.0)) * ((R1 + R2) / R2);
  float voltage3 = (sensorValue3 * (5.0 / 1023.0)) * ((R1 + R2) / R2);
  float voltage4 = (sensorValue4 * (5.0 / 1023.0)) * ((R1 + R2) / R2);
  float voltage5 = (sensorValue5 * (5.0 / 1023.0)) * ((R1 + R2) / R2);
  // Calculate actual voltage

  display.clearDisplay();
  
  display.setTextSize(1);             
  display.setTextColor(WHITE);    

  display.setCursor(0,0);
  display.print("V1: ");
  display.print(voltage1);

  display.setCursor(0,10);
  display.print("V2: ");
  display.print(voltage2);

  display.setCursor(0,20);
  display.print("V3: ");
  display.print(voltage3);

  display.setCursor(60,0);
  display.print("V4: ");
  display.print(voltage4);

  display.setCursor(60,10);
  display.print("V5: ");
  display.print(voltage5);

  display.display();


  delay(500); 

}